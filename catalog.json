  "escolhas": [
    {
      "id": "EscolhasTexto",
      "titulo": "Escolhas · texto",
      "pares": [
        {
          "pergunta": "Como o título entra em cena?",
          "a": "TrackingIn — espaçamento fecha",
          "b": "BlurFocusIn — desfoque ganha foco",
          "criterio": "TrackingIn dá sensação de algo assentando — bom para nome de marca e abertura formal. BlurFocusIn imita foco de câmera e combina com peça que tem imagem ou vídeo por baixo. Em fundo chapado, o desfoque some."
        },
        {
          "pergunta": "Como a frase aparece?",
          "a": "StaggeredFadeUp — palavra a palavra",
          "b": "MatrixDecode — resolve do ruído",
          "criterio": "Stagger respeita o ritmo de leitura: a pessoa lê enquanto entra. MatrixDecode é ilegível durante metade da animação — use quando o efeito É a mensagem (tecnologia, decifrar), nunca quando o texto precisa ser lido rápido."
        }
      ]
    },
    {
      "id": "EscolhasCena",
      "titulo": "Escolhas · dado e fundo",
      "pares": [
        {
          "pergunta": "Como mostrar um percentual?",
          "a": "Counter — o número subindo",
          "b": "ProgressBar — a barra enchendo",
          "criterio": "O contador entrega a grandeza (78 é muito ou pouco?). A barra entrega a proporção (78 de 100). Se o número é o argumento, use contador; se o que importa é quanto falta para o total, use barra. Os dois juntos é redundância."
        },
        {
          "pergunta": "Que fundo colocar atrás do texto?",
          "a": "MeshGradientBg — orgânico, respira",
          "b": "DynamicGrid — técnico, discreto",
          "criterio": "O gradiente tem luminosidade variável: texto claro some nas partes claras. A grade mantém contraste uniforme e nunca disputa. Regra prática: gradiente para peça emocional e título curto; grade para peça informativa e texto longo."
        }
      ]
    }
  ],
