{
  "name": "remotion-agent-catalog",
  "version": "0.1.0",
  "description": "A validated Remotion component catalog for agents and teams: what exists, where it came from, and where it fails in practice.",
  "type": "module",
  "license": "MIT",
  "author": "@ovictor",
  "homepage": "https://github.com/victorsodre/remotion-agent-catalog#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/victorsodre/remotion-agent-catalog.git"
  },
  "bin": {
    "remotion-catalog": "bin/catalog.mjs",
    "remotion-catalog-mcp": "bin/mcp-server.mjs"
  },
  "files": [
    "catalog.json",
    "schema/catalog.schema.json",
    "bin",
    "scripts/catalog-lib.mjs",
    "scripts/serve.mjs",
    "web",
    "src",
    "AGENTS.md",
    "README.md"
  ],
  "scripts": {
    "validate": "node scripts/validate.mjs",
    "check:web-i18n": "node scripts/check-web-i18n.mjs",
    "mcp": "node bin/mcp-server.mjs",
    "web": "node scripts/serve.mjs",
    "studio": "remotion studio",
    "dev": "remotion studio",
    "compositions": "remotion compositions",
    "libs": "node scripts/pull-remotion-ui.mjs",
    "previews:link": "node scripts/link-previews.mjs",
    "previews:list": "node scripts/link-previews.mjs --list",
    "previews:render": "node scripts/render-catalog-previews.mjs",
    "previews:render:marketing": "node scripts/render-marketing-previews.mjs",
    "test": "node --test",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "remotion",
    "agent",
    "catalog",
    "ai",
    "mcp",
    "video"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@remotion/captions": "^4.0.513",
    "@remotion/cli": "^4.0.513",
    "@remotion/google-fonts": "^4.0.513",
    "@remotion/layout-utils": "^4.0.513",
    "@remotion/media": "^4.0.513",
    "@remotion/media-utils": "^4.0.513",
    "@remotion/paths": "^4.0.513",
    "@remotion/transitions": "^4.0.513",
    "culori": "^4.0.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "remotion": "^4.0.513",
    "remotion-bits": "^0.2.0",
    "three": "^0.182.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "^0.182.0",
    "ajv": "^8.17.1",
    "typescript": "~5.8.3"
  }
}
